# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase (public: sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only: full database access, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (public key id: sent to the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
